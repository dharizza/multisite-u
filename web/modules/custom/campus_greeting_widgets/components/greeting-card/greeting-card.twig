<div class="greeting-card">
  <img alt="" src="{{ icon_url }}" class="greeting-card__icon" width="32" height="32">
  <h5 class="greeting-card__name">{{ name }}</h5>
  <span class="greeting-card__date">{{ date }}</span>
  <p class="greeting-card__message">{{ message }}</p>
  <div class="greeting-card__like" data-greeting-like>👍 {{ 'Me gusta'|t }}</div>
</div>
