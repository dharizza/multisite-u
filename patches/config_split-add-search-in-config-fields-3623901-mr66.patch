+  /**
+   * Wraps a checkbox list in a fieldset with a filter input above it.
+   *
+   * The lists of modules and configuration items are long enough that scrolling
+   * them is impractical, so each one gets a search box which hides the options
+   * that do not match what is typed, and an area below it, styled like the list
+   * itself, that the javascript moves the checked options into so that a
+   * selection is never scrolled or filtered out of sight. The label and the
+   * description move up to the fieldset so that both sit inside the group they
+   * belong to, and the javascript finds them through the
+   * data-config-split-filter-target attribute. Neither is rendered when
+   * javascript is off.
+   *
+   * The checkboxes element keeps its key, so its #parents and the values read
+   * in ::submitForm() are unaffected by the extra level of nesting.
+   *
+   * @param array $container
+   *   The form section the checkboxes element is in.
+   * @param string $key
+   *   The key of the checkboxes element in that section.
+   * @param \Drupal\Core\StringTranslation\TranslatableMarkup $title
+   *   The label of the filter input, which is visually hidden.
+   *
+   * @see js/config_split_form.js
+   */
+  protected function wrapWithFilter(array &$container, $key, TranslatableMarkup $title) {
+    $element = $container[$key];
+    unset($container[$key]);
+
+    $container[$key . '_wrapper'] = [
+      '#type' => 'fieldset',
+      '#title' => $element['#title'],
+      '#description' => $element['#description'],
+      '#description_display' => 'after',
+      '#attributes' => ['data-config-split-filter-target' => $key],
+      $key . '_filter' => [
+        '#type' => 'search',
+        '#title' => $title,
+        '#title_display' => 'invisible',
+        '#size' => 30,
+        '#attributes' => [
+          'class' => ['config-split-filter-text'],
+          'data-config-split-filter' => $key,
+          'autocomplete' => 'off',
+        ],
+        '#wrapper_attributes' => ['class' => ['config-split-filter', 'js-show']],
+      ],
+    ];
+
+    // The fieldset carries the label and the description now, so the element
+    // does not wrap itself in one as well.
+    unset($element['#title'], $element['#description']);
+    $container[$key . '_wrapper'][$key] = $element;
+
+    $container[$key . '_wrapper'][$key . '_selected'] = [
+      '#type' => 'container',
+      '#attributes' => [
+        'class' => ['config-split-selected'],
+        'data-config-split-selected' => $key,
+      ],
+      // Kept for screen readers, which otherwise meet a second list of
+      // checkboxes with nothing to tell them what it is.
+      'label' => [
+        '#type' => 'html_tag',
+        '#tag' => 'span',
+        '#attributes' => [
+          'class' => ['config-split-selected-label', 'visually-hidden'],
+        ],
+        '#value' => $this->t('Selected'),
+      ],
+      'items' => [
+        '#type' => 'container',
+        '#attributes' => [
+          'class' => ['form-checkboxes', 'config-split-selected-items'],
+        ],
+      ],
+    ];
+  }
+
   /**
